<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cliptool.api</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOURUSER/path/to/claude-mac-mini-migration/projects/cliptool/.venv/bin/python3</string>
    <string>-m</string>
    <string>cliptool.cli</string>
    <string>serve</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8787</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/YOURUSER/path/to/claude-mac-mini-migration/projects/cliptool</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/cliptool-api.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/cliptool-api.err.log</string>
</dict>
</plist>

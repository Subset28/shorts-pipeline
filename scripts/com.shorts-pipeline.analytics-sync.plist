        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>23</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/abba/Library/Logs/shorts-pipeline/analytics-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/abba/Library/Logs/shorts-pipeline/analytics-sync.error.log</string>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.shorts-pipeline.analytics-sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/n2me/Developer/shorts-pipeline/scripts/run-weekly-analytics.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Volumes/n2me/Developer/shorts-pipeline</string>

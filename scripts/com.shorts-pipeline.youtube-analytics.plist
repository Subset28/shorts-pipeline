<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.shorts-pipeline.youtube-analytics</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/n2me/Developer/shorts-pipeline/scripts/run-youtube-analytics.sh</string>
        <string>--weekly</string>
    </array>
    <key>StartInterval</key>
    <integer>86400</integer>
    <key>StandardOutPath</key>
    <string>/Volumes/n2me/Developer/shorts-pipeline/data/youtube-analytics.log</string>
    <key>StandardErrorPath</key>
    <string>/Volumes/n2me/Developer/shorts-pipeline/data/youtube-analytics.error.log</string>
</dict>
</plist>

LLM_PROVIDER=fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DRY_RUN=false
DOTENV_PATH=.env
YOUTUBE_PRIVACY_STATUS=public
YOUTUBE_CLIENT_SECRETS=client_secrets.json
YOUTUBE_TOKEN_FILE=token.json
YOUTUBE_ANALYTICS_TOKEN_FILE=youtube_analytics_token.json
YOUTUBE_REPORTING_JOB_FILE=data/youtube_reporting_job.json
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
ELEVENLABS_ROTATOR_PATH=C:\Users\Armaa\Downloads\elevenlabs_tts_rotator.py
ELEVENLABS_KEYS_FILE=C:\Users\Armaa\Downloads\shorts-pipeline\keys.json
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
TTS_PROVIDER=auto
MACOS_TTS_VOICE=Reed (English (US))
MACOS_TTS_RATE=205
EDGE_TTS_VOICE=en-US-GuyNeural
# Pixazo is disabled by default. Configure one authorized paid API key; do not
# add accounts or keys to evade provider limits. The adapter enforces this local
# request cap and never prints the key.
PIXAZO_ENABLED=false
PIXAZO_API_KEY=
PIXAZO_BASE_URL=https://gateway.pixazo.ai
PIXAZO_DAILY_REQUEST_LIMIT=0
PIXAZO_ALLOWED_MODELS=ltx
PIXAZO_STATE_FILE=data/pixazo_usage.json
CAPTIONS_ENABLED=true
CAPTION_MODEL=base
BACKGROUND_VIDEO=
BACKGROUND_VIDEO_DIR=data/backgrounds
REDDIT_BACKGROUND_DIR=data/backgrounds/minecraft_parkour_chunks
BACKGROUND_REEL_ENABLED=false
REDDIT_ASSETS_DIR=assets/reddit
BACKGROUND_MANIFEST=assets/backgrounds.json
BACKGROUND_VIDEO_URL=
TOPIC_LIMIT=10
OUTPUT_DIR=output
# Cap unattended FFmpeg CPU use; values are clamped to 1-4 threads.
FFMPEG_THREADS=2
DATA_DIR=data
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=shorts-pipeline/1.0
REDDIT_SUBREDDITS=TalesFromTechSupport,AskReddit,aviation,flying,sysadmin,AskEngineers,cscareerquestions,AerospaceEngineering,cybersecurity,MachineLearning,ExperiencedDevs,ProgrammerHumor,rocketry,SpaceX,netsec,hacking,OSINT,techsupport,ShittySysAdmin
